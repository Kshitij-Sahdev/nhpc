# ============================================================
# NHPC Hydro Weather Warning System — Configuration File
# ============================================================
# Rename this file to '.env' and fill in the details.
# All settings have sensible defaults — only override what you need.

# --- APPLICATION ---
# APP_PORT=8000
# APP_ENV=development              # "development" or "production"

# --- LOGGING ---
# LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT=text                  # "text" (colored for dev) or "json" (structured for prod)
# LOG_FILE=                        # Empty = stdout only. Set path for file logging with rotation.

# --- DATABASE ---
# DB_PATH=data/nhpc_weather.db     # SQLite database file path
# DB_CLEANUP_DAYS=90               # Auto-delete forecast data older than N days
# DB_BACKUP_RETAIN=7               # Number of database backups to keep

# --- IMD API ---
# IMD_BASE_URL=https://mausamgram.imd.gov.in
# IMD_REQUEST_TIMEOUT=10           # Seconds
# IMD_MAX_RETRIES=2
# IMD_CACHE_TTL=1800               # In-memory cache TTL (seconds, default 30 min)

# --- ALERT THRESHOLDS (mm / m/s) ---
# ALERT_RAIN_3H_RED=30.0
# ALERT_RAIN_3H_YELLOW=15.0
# ALERT_RAIN_24H_RED=100.0
# ALERT_RAIN_24H_YELLOW=50.0
# ALERT_GUST_RED=25.0
# ALERT_GUST_YELLOW=15.0

# --- RATE LIMITING ---
# RATE_LIMIT_RPM=60                # Max API requests per minute per IP (0 = disabled)

# --- TELEGRAM ALERTS ---
# Create a Telegram Bot via @BotFather to get the token.
# Add the bot to your channel/group and use a bot like @RawDataBot to get the chat_id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id_here

# --- SLACK ALERTS ---
# Create an Incoming Webhook in Slack (or create a Slack App and add Webhook integration)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# --- EMAIL (SMTP) ALERTS ---
# Configure your outgoing mail server parameters (e.g. Gmail SMTP or corporate SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, you must generate an "App Password" rather than your actual account password.
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_SENDER=nhpc_warning_alert@yourdomain.com
ALERT_RECIPIENT_EMAIL=safety_officer@nhpc.co.in
