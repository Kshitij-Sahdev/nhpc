# NHPC Hydro Weather Warning System Configuration File Template
# Rename this file to '.env' and fill in the details to enable live notifications.

# --- TELEGRAM ALERTS ---
# Create a Telegram Bot via @BotFather to get the token.
# Add the bot to your channel/group and use a bot like @RawDataBot to get the chat_id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id_here

# --- SLACK ALERTS ---
# Create an Incoming Webhook in Slack (or create a Slack App and add Webhook integration)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# --- EMAIL (SMTP) ALERTS ---
# Configure your outgoing mail server parameters (e.g. Gmail SMTP or corporate SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, you must generate an "App Password" rather than your actual account password.
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_SENDER=nhpc_warning_alert@yourdomain.com
ALERT_RECIPIENT_EMAIL=safety_officer@nhpc.co.in
